{
  "extends": "@prefabs.tech/tsconfig/fastify.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolvePackageJsonExports": false,
    "outDir": "./dist",
    "paths": {
      "@types": ["./src/*"]
    }
  },
  "exclude": ["src/**/__test__/**/*", "vite.config.ts"],
  "include": ["src/**/*.ts"],
}
