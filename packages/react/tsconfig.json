{
  "extends": "@prefabs.tech/tsconfig/react",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolvePackageJsonExports": false,
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": ["vite.config.ts"],
  "include": ["src/**/*", "src/**/*.tsx", "./setup-test.ts"]
}
